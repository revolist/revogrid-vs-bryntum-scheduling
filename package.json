{
  "name": "revogrid-vs-bryntum-scheduling",
  "version": "1.0.0",
  "private": true,
  "description": "A reproducible visual distinction between RevoGrid Gantt resource planning and Event Scheduler.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.13.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@revolist/revogrid": "4.24.2",
    "@revolist/revogrid-enterprise": "npm:@revolist/rv-enterprise-trial@2.4.0",
    "@revolist/revogrid-pro": "npm:@revolist/rv-pro-trial@2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  },
  "pnpm": {
    "overrides": {
      "@revolist/revogrid@4.24.2": "https://registry.npmjs.org/@revolist/revogrid/-/revogrid-4.24.2.tgz"
    }
  }
}
